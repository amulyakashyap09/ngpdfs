{
  "name": "paperzero",
  "private": true,
  "version": "0.1.0",
  "description": "PaperZero - PDF tools that never see your PDFs. Local-first, privacy-first browser document toolkit.",
  "license": "UNLICENSED",
  "privateWorkspaces": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "dev": "npm run dev -w apps/web",
    "build": "npm run build -w apps/web",
    "start": "npm run start -w apps/web",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --if-present --workspaces",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "node scripts/copy-pdf-worker.mjs"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.4",
    "@types/react-dom": "^19.0.2",
    "eslint": "^9.18.0",
    "eslint-config-next": "^15.3.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
